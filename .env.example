# Copy to .env, fill in, and keep it out of version control.
# A shared deployment must set every value here; the defaults are local only.

ISSUER_ENV=shared
ISSUER_ORIGIN=https://utsteder.example.no
ISSUER_NAME=Demo-utsteder (syntetisk)
ISSUER_CONTACT=navn@example.no

# Synthetic demonstration data. Set to false for anything real, which also
# removes the endpoints that invent facts about people.
ISSUER_DEMO=true

# Registered applications. A client may only do what its scopes allow, and a
# claim type may name the single client permitted to issue it.
# Generate tokens with: openssl rand -hex 24
ISSUER_CLIENTS_JSON=[{"id":"calendar","token":"CHANGE-ME","scopes":["issue","query"]},{"id":"politiet-backend","token":"CHANGE-ME","scopes":["issue"]}]

# Where public claims are published. "none" keeps everything with the issuer.
ISSUER_PUBLISHER=none
# ATPROTO_SERVICE=http://pds:3000
# ATPROTO_IDENTIFIER=utsteder.example
# ATPROTO_PASSWORD=

# The signing key is generated into ISSUER_DATA_DIR on first start and must be
# backed up: losing it invalidates every attestation the issuer has made.
ISSUER_DATA_DIR=/data
ISSUER_KEY_ID=key-1
