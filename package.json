{
  "name": "attestation-issuer",
  "version": "0.1.0",
  "private": true,
  "description": "A reusable attestation issuer: an organisation states a narrow, checkable fact about an account, and any application can verify it without reaching the organisation's data.",
  "license": "MIT",
  "bin": {
    "attest-issuer": "dist/src/cli.js",
    "attest-verify": "dist/verify/cli.js"
  },
  "type": "module",
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "docker compose up -d --build --wait",
    "down": "docker compose down",
    "logs": "docker compose logs -f issuer",
    "test": "node --test dist/test/*.test.js",
    "issuer": "node dist/src/cli.js",
    "verify:claim": "node dist/verify/cli.js",
    "prestart": "pnpm run build",
    "build": "tsc && node scripts/assets.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "preissuer": "pnpm run build",
    "preverify:claim": "pnpm run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "pack:verifier": "pnpm run build && pnpm --dir dist/verify pack --pack-destination ..",
    "test:package": "pnpm run pack:verifier && node scripts/check-verifier.ts",
    "pilot": "node dist/src/pilot/server.js",
    "test:pilot-integration": "pnpm build && node scripts/pilot-fixture.mjs",
    "pilot:preview": "pnpm build && node scripts/pilot-fixture.mjs --serve",
    "check": "node scripts/checks.ts",
    "lint": "oxlint --deny-warnings",
    "fix": "ultracite fix",
    "org:enrol": "node src/pilot/enrol.ts",
    "test:integration": "pnpm --dir pilot-fixture install --frozen-lockfile && pnpm test:pilot-integration"
  },
  "dependencies": {
    "@atproto/api": "0.24.0",
    "@atproto/identity": "0.5.16",
    "@atproto/repo": "0.11.0",
    "@loftet/auth": "file:vendor/loftet-auth-0.3.0.tgz"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "ultracite": "8.0.1"
  },
  "engines": {
    "node": ">=24.17 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.8.0"
}
