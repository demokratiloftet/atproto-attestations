+
+test("affiliation pilot exposes only reviewed application routes", () => {
+  const host = "tilknytning.hackaton.demokratiloftet.no";
+  for (const path of [
+    "/api/state",
+    "/api/demo",
+    "/api/trust",
+    "/api/credential?id=abc",
+    "/status/abc-123",
+  ])
+    assert(hackathonAllowed(host, "GET", path));
+  for (const path of [
+    "/api/login",
+    "/api/logout",
+    "/api/proposals",
+    "/api/proposals/approve",
+    "/api/proposals/change",
+    "/api/proposals/decline",
+    "/api/proposals/revoke",
+    "/api/proposals/retry",
+    "/api/grants",
+    "/api/grants/revoke",
+    "/api/events",
+  ])
+    assert(hackathonAllowed(host, "POST", path));
+  for (const path of [
+    "/issue",
+    "/revoke",
+    "/audit",
+    "/demo/enrol",
+    "/query",
+    "/api/reset",
+    "/xrpc/com.atproto.repo.putRecord",
+  ])
+    for (const method of ["GET", "POST"])
+      assert(!hackathonAllowed(host, method, path));
+  assert(!hackathonAllowed(viewer, "GET", "/api/trust"));
+  assert(!hackathonAllowed(publisher, "POST", "/api/grants"));
+});
